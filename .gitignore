# Canonical PDF artifacts and manifest/state artifacts (generated at runtime)
Analyzer/Paper/*
!Analyzer/Paper/.gitkeep
Analyzer/Manifest/*
Analyzer/Manifest/.*
!Analyzer/Manifest/.gitkeep
# Safe, deterministic source_id ↔ title-PDF mapping used by every consumer.
!Analyzer/Manifest/paper_files.json
!Analyzer/Manifest/paper_profiles.json
# Reviewed Level-3 decisions are source data for the reproducible Excel export.
!Analyzer/Manifest/Lv3/
!Analyzer/Manifest/Lv3/*.json
# KCI reference collector runtime outputs
Analyzer/Ref/*.xlsx
Analyzer/Ref/.*.xlsx
Analyzer/Ref/.cache/
# KCI Open Access collector runtime outputs
Analyzer/OA/*.xlsx
Analyzer/OA/.*.xlsx
Analyzer/OA/.cache/
# KCI Special Issue collector runtime outputs
Analyzer/Special-Issue/*.xlsx
Analyzer/Special-Issue/.*.xlsx
Analyzer/Special-Issue/.cache/
Analyzer/Special-Issue/BibTex/*.bib
# Legacy artifact location retained for read/reuse compatibility
Papers/

