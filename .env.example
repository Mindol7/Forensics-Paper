KCI_OPEN_API_KEY=your_kci_open_api_key_here
KCI_OPEN_API_URL=https://open.kci.go.kr/po/openapi/openApiSearch.kci
REQUEST_TIMEOUT=30
KCI_PAGE_SIZE=100
KCI_MAX_PAGES=
KCI_START_YEAR=2022
# Leave KCI_END_YEAR empty: the window then extends to the current year on its
# own every January.  Set a year only to stop collecting after it.
KCI_END_YEAR=
KCI_RECENT_YEARS=5
KCI_MAX_WORKERS=4
# Target request rate (req/sec). The limiter self-tunes (AIMD): it halves on
# KCI throttling/slow-drip and recovers back toward this ceiling on healthy
# responses. Raise to go faster (capped at 4); lower if KCI keeps throttling.
KCI_RATE_LIMIT_RPS=2
# PDF 파이프라인의 KCI articleDetail DOI 복구는 더 보수적으로 실행합니다.
KCI_DETAIL_RPS=0.5
KCI_ENABLE_SWEEP=true
KCI_SWEEP_MAX_WORKERS=1
KCI_KEYWORD_FILTER_KEYWORDS_PATH=Processor/refs/keywords_json.ko
KCI_KEYWORD_FILTER_ENGLISH_KEYWORDS_PATH=Processor/refs/keywords_json.en
KCI_BLACKLIST_PATH=Processor/refs/blacklist.list
DATABASE_URL=sqlite:///kci_pipeline.db
EXPORT_DIR=reports
STATE_KEY_LAST_SUCCESS_AT=kci:last_success_at

# PDF 수집 및 기존 standalone 분석 pipeline
# 새 PDF와 manifest/state를 각각 분리 저장합니다.
ANALYZER_PAPER_DIR=Analyzer/Paper
ANALYZER_MANIFEST_DIR=Analyzer/Manifest
PAPER_DOWNLOAD_WORKERS=4
PAPER_IDENTIFIER_WORKERS=4
PAPER_CONNECT_TIMEOUT=10
PAPER_READ_TIMEOUT=60
PAPER_HTTP_RETRIES=2
PAPER_PER_HOST_RPS=2
PAPER_MAX_PDF_MB=50
PAPER_MAX_TEXT_CHARS=600000
PAPER_MIN_TEXT_CHARS=200
UNPAYWALL_EMAIL=
OPENALEX_API_KEY=
# Elsevier Article Retrieval API용 별도 키
ELSEVIER_API_KEY=
# 기관 구독 권한을 API에 연결해야 할 때 Elsevier가 발급한 서버 측 token만 사용합니다.
# ScienceDirect 웹 ID/PW나 cookie를 여기에 넣지 않습니다.
ELSEVIER_INSTITUTION_TOKEN=
# 새 workflow는 Semantic Scholar 익명 요청을 기본 사용하며, 실제 키가 있으면
# 자동으로 사용합니다. 기존 standalone CLI에서는 --semantic-scholar가 필요합니다.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_RPS=0.045
SEMANTIC_SCHOLAR_BATCH_SIZE=100
CROSSREF_EMAIL=
# DBpia Open API는 article 상세페이지 식별에만 사용하며 PDF 원문/권한을 반환하지 않습니다.
# 키·검색 응답·카탈로그·파생 NODE/숫자형 ID/URL은 cache/log/성공·실패 manifest에 저장하지 않습니다.
# 키 설정만으로 검색/PDF 자동화가 켜지지 않습니다. 아래 Open API 값은
# browser 제목 검색에는 사용되지 않으며, 별도 discovery 옵션에서만 씁니다.
# 기본 0.5 RPS와 별개로 사용자 상태 디렉터리의 forensics-paper quota 파일이
# 한국시간 기준 공식 일일 2,500회 한도를 출력 경로/프로세스 간 공유합니다.
DBPIA_API_KEY=
DBPIA_SEARCH_RPS=0.5
DBPIA_OPENAPI_MAX_REQUESTS=500
# 기본 kdfs. 선택한 타 학회까지 exact journal/publisher별로 찾을 때만 selected.
DBPIA_OPENAPI_SCOPE=kdfs
# DBpia browser 제목검색/다운로드 인증. 실제 값은 gitignored .env에만 넣고
# 채팅·명령행·로그에는 입력하지 마세요. 둘 중 하나만 설정하면 실행을 거부합니다.
DBPIA_LOGIN_ID=
DBPIA_LOGIN_PASSWORD=
# 기관 구독 배지를 반드시 확인하려면 기관명을 설정합니다.
DBPIA_REQUIRED_INSTITUTION_NAME=고려대학교
# cookie/JWT를 .env에 넣지 않고, browser cookie는 저장소 밖 전용 profile에 둡니다.
DBPIA_BROWSER_PROFILE_DIR=
DBPIA_BROWSER_MIN_INTERVAL=10
# 부분 성공을 저장하고 다음 실행에서 재개하도록 한 실행의 실제 browser 시도 상한.
# 마지막 실제 시도 DB 행은 새 workflow에서는 ANALYZER_MANIFEST_DIR 아래에,
# standalone CLI도 ANALYZER_MANIFEST_DIR 아래에 URL/쿠키 없이 저장합니다.
DBPIA_BROWSER_MAX_ATTEMPTS=25
DBPIA_BROWSER_MAX_SEARCH_RESULTS=20

# 학술지명/발행기관/DOI prefix를 provider에 연결하는 명시적 route table.
# '법학연구소'처럼 여러 기관에 중복되는 이름만으로는 라우팅하지 않습니다.
PDF_PROVIDER_ROUTES_PATH=Processor/refs/pdf_routes.json

# 교보 Scholar와 KDFS JAMS는 사이트/기관의 자동 수집 허용을 확인한 뒤에만
# 각각 --enable-kyobo / --enable-jams로 켭니다. 비밀번호·cookie·인증키는
# 설정 파일에 넣지 않고 서비스별 전용 프로필에서 사용자가 직접 로그인합니다.
KYOBO_BROWSER_PROFILE_DIR=
KYOBO_BROWSER_MIN_INTERVAL=10
KYOBO_BROWSER_MAX_ATTEMPTS=25
KYOBO_BROWSER_MAX_SEARCH_RESULTS=20
JAMS_BROWSER_PROFILE_DIR=
JAMS_BROWSER_MIN_INTERVAL=10
JAMS_BROWSER_MAX_ATTEMPTS=25
CODEX_EXECUTABLE=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
CODEX_ANALYSIS_TIMEOUT=900
CODEX_ANALYSIS_RETRIES=1

# --- Claude analysis stage (Scheduler.pipeline analyze) ---------------------
# Credentials are resolved by the Anthropic SDK: either this key or an
# `ant auth login` profile. Without them the analyze stage is skipped and the
# affected papers are reported as pending.
ANTHROPIC_API_KEY=
# Model used for the two-call paper analysis (default: claude-opus-5).
CLAUDE_ANALYSIS_MODEL=
# Analysis transport: auto (API key if set, else the Claude Code CLI),
# api, or claude-code. The CLI runs headlessly (`claude -p`) under the
# operator's Claude subscription, so no API billing is involved.
CLAUDE_ANALYSIS_BACKEND=auto
# Optional explicit path to the Claude Code binary when it is not on PATH.
CLAUDE_CODE_EXECUTABLE=
